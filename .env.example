# Local development only. Never reuse these values in a hosted environment.
DJANGO_SECRET_KEY=local-only-change-before-hosting
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=socialhub
POSTGRES_USER=socialhub
POSTGRES_PASSWORD=socialhub-local-only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

SOCIALHUB_DEFAULT_SOURCE_MODE=combined
SOCIALHUB_DEFAULT_ACCOUNT_TIME_ZONE=Asia/Tehran

# Instagram connection (E00-S04, docs/INSTAGRAM-INTEGRATION.md section 9). Publishing is switched
# per account (`publishing_enabled`); there is no global publisher setting any more.
# Fernet key(s) for stored access tokens; comma-separated for rotation (first encrypts, all
# decrypt). Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Local only; never reuse it in a hosted environment.
SOCIALHUB_ENCRYPTION_KEY=
# Provider of a new account's connection, and the ones an admin may choose. `graph_api` is
# reserved: its adapter is not built yet, so it cannot be the default and choosing or
# connecting it answers 503 provider_not_configured.
SOCIALHUB_IG_DEFAULT_PROVIDER=fake
SOCIALHUB_IG_ALLOWED_PROVIDERS=fake,manual,graph_api
SOCIALHUB_IG_CAPABILITY_OVERRIDES={}
SOCIALHUB_IG_TOKEN_REFRESH_AFTER_DAYS=7
SOCIALHUB_IG_MEDIA_URL_TTL_SECONDS=7200
# Where the OAuth callback sends the browser back (the panel origin).
SOCIALHUB_PANEL_URL=http://localhost:5173
# Meta app (graph_api only; set from the E00-S04 setup spike). The secret is never logged.
SOCIALHUB_META_APP_ID=
SOCIALHUB_META_APP_SECRET=
SOCIALHUB_META_REDIRECT_URI=http://localhost:8000/api/v1/instagram/oauth/callback/
SOCIALHUB_IG_API_VERSION=
SOCIALHUB_IG_HTTP_PROXY=

# Media storage (E00-S06). Hosted environments must use s3; local is refused when DJANGO_DEBUG=false.
SOCIALHUB_MEDIA_BACKEND=local
SOCIALHUB_MEDIA_BASE_URL=http://localhost:8000/media/
SOCIALHUB_MEDIA_URL_TTL_SECONDS=21600
SOCIALHUB_WORK_DIR=
# s3 only. For the optional MinIO service: SOCIALHUB_S3_ENDPOINT_URL=http://minio:9000
SOCIALHUB_S3_BUCKET=
SOCIALHUB_S3_ENDPOINT_URL=
SOCIALHUB_S3_REGION=us-east-1
SOCIALHUB_S3_ACCESS_KEY_ID=
SOCIALHUB_S3_SECRET_ACCESS_KEY=
SOCIALHUB_S3_ADDRESSING_STYLE=path
SOCIALHUB_S3_PUBLIC_BASE_URL=

# AI gateway (E00-S05, docs/AI-INTEGRATION.md). `fake` needs no keys and is refused when
# DJANGO_DEBUG=false. Real keys come only from the environment; never commit them.
SOCIALHUB_AI_TEXT_PROVIDER=fake
SOCIALHUB_AI_IMAGE_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SOCIALHUB_AI_TEXT_MODEL=claude-opus-5-5
SOCIALHUB_AI_TEXT_MODEL_OVERRIDES={}
# OpenAI's current image model, confirmed at deployment (for example gpt-image-2).
SOCIALHUB_AI_IMAGE_MODEL=
SOCIALHUB_AI_IMAGE_SIZES={"square": "1024x1024", "portrait": "1024x1536", "landscape": "1536x1024"}
# Extra or replacement price rows keyed by model ID; the Claude seed prices are built in.
SOCIALHUB_AI_PRICES={}
SOCIALHUB_AI_TIMEOUT_SECONDS=180
SOCIALHUB_AI_MAX_CALLS_PER_JOB=20
SOCIALHUB_AI_MAX_IMAGES_PER_ITEM=12
SOCIALHUB_PRODUCTION_AUTO_IMAGES=false
SOCIALHUB_REPORT_LANGUAGE=en
SOCIALHUB_TESTING_HOOKS=false
SOCIALHUB_APP_VERSION=0.1.0
SOCIALHUB_ENVIRONMENT=development

# Jobs (E00-S06): JSON map of job kind to running timeout in seconds.
SOCIALHUB_JOB_TIMEOUT_OVERRIDES={}

# Local and E2E users created by `python manage.py seed_users` (E00-S01).
SOCIALHUB_E2E_PASSWORD=
