# Local development only. Never reuse these values in a hosted environment.
DJANGO_SECRET_KEY=local-only-change-before-hosting
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=socialhub
POSTGRES_USER=socialhub
POSTGRES_PASSWORD=socialhub-local-only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Defaults deliberately use local fixture adapters. Real sending is not implemented.
SOCIALHUB_SOURCE_PROVIDER=fixture
SOCIALHUB_MODEL_PROVIDER=fixture
SOCIALHUB_PUBLISHER_PROVIDER=disabled
SOCIALHUB_PUBLISHING_ENABLED=false
SOCIALHUB_DEFAULT_SOURCE_MODE=combined
SOCIALHUB_DEFAULT_ACCOUNT_TIME_ZONE=Asia/Tehran

# AI gateway (docs/AI-INTEGRATION.md). `fake` runs everything from fixtures without keys.
SOCIALHUB_AI_TEXT_PROVIDER=fake
# ANTHROPIC_API_KEY=
# SOCIALHUB_AI_TEXT_MODEL=claude-opus-5-5
# SOCIALHUB_AI_MAX_CALLS_PER_JOB=20

# Research and outbound fetching (E02)
# SOCIALHUB_HTTP_USER_AGENT=SocialHubBot/1.0
# SOCIALHUB_RESEARCH_BLOCKED_DOMAINS=
# Private hosts safe_fetch may reach; honoured only with DJANGO_DEBUG=true or testing hooks.
# SOCIALHUB_FETCH_ALLOW_HOSTS=
# SOCIALHUB_RESEARCH_MAX_TOPICS=8
