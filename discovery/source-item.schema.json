{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socialhub.invalid/schemas/source-item-1.0.json",
  "title": "Social Hub normalized source item",
  "description": "Normalized source evidence record. Use only for source items retrieved through approved, permitted paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_key",
    "source_type",
    "publisher",
    "canonical_url",
    "observed_at",
    "status",
    "eligibility",
    "provenance",
    "content_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_key": {
      "type": "string",
      "minLength": 1,
      "description": "Stable, namespaced key from the connector, not a Social Hub database ID."
    },
    "external_id": {"type": ["string", "null"]},
    "source_type": {
      "enum": ["company_feed", "industry_source", "search_signal", "social_signal", "sector_account"]
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "account_ref": {"type": ["string", "null"]},
        "domain": {"type": ["string", "null"]}
      }
    },
    "canonical_url": {"type": "string", "format": "uri"},
    "title": {"type": ["string", "null"]},
    "excerpt": {
      "type": ["string", "null"],
      "description": "Only retain an excerpt/snapshot when the source terms and owner permit it."
    },
    "language": {"type": ["string", "null"], "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "source_updated_at": {"type": ["string", "null"], "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "observed_at"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "field_path": {"type": ["string", "null"]}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "policy_version", "reasons"],
      "properties": {
        "state": {"enum": ["eligible", "ineligible", "uncertain"]},
        "policy_version": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": ["string", "null"], "format": "date-time"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval_method", "connector_version", "rights_status", "permitted_uses"],
      "properties": {
        "retrieval_method": {"enum": ["api", "feed", "licensed_service", "approved_export", "manual_reference"]},
        "connector_version": {"type": "string", "minLength": 1},
        "api_version": {"type": ["string", "null"]},
        "request_ref_redacted": {"type": ["string", "null"]},
        "rights_status": {"enum": ["owned", "licensed", "public_permitted", "unknown", "blocked"]},
        "rights_basis": {"type": ["string", "null"]},
        "rights_expires_at": {"type": ["string", "null"], "format": "date-time"},
        "permitted_uses": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["research", "summarize", "quote", "retain_evidence", "derive_content", "publish_link"]}
        },
        "retention_rule": {"type": ["string", "null"]}
      }
    },
    "evidence_locators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "observed_at"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "field_path": {"type": ["string", "null"]},
          "observed_at": {"type": "string", "format": "date-time"},
          "snapshot_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "content_fingerprint": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor_redacted": {"type": ["string", "null"]},
        "page_number": {"type": ["integer", "null"], "minimum": 1},
        "freshness_window_seconds": {"type": ["integer", "null"], "minimum": 0},
        "rate_limit_remaining": {"type": ["integer", "null"], "minimum": 0},
        "rate_limit_reset_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
